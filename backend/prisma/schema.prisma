// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PARTNER
  CAREER
  USER
}

model User {
  id    String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  // Role-specific one-to-one relations
  partner    Partner?
  career     Career?
  admin      Admin?
  userData   UserData?
}

model Partner {
  id    String   @id @default(uuid())
  userId     String    @unique
  user       User   @relation(fields: [userId], references: [id])
  
  first_name String
  last_name  String
  phone      String
  portfolio  String
  artisan    String
 
  do_you_train     String?
  willing_to_train String?


  approved   Boolean @default(false) // Partners require approval
}

enum Gender {
  male
  female
}

model Career {
  id    String   @id @default(uuid())
  userId     String     @unique
  user       User    @relation(fields: [userId], references: [id])
  
  first_name String
  last_name  String
  phone      String
  gender     Gender
}

model Admin {
  id    String   @id @default(uuid())
  userId     String    @unique
  user       User   @relation(fields: [userId], references: [id])

  name       String
}

model UserData {
  id    String   @id @default(uuid())
  userId   String    @unique
  user     User   @relation(fields: [userId], references: [id])

  name     String
  phone    String
}

model OTP {
  id         Int      @id @default(autoincrement())
  email      String
  otp        String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}
