// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PARTNER
  CAREER
  USER
}

enum Gender {
  male
  female
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  image     String?
  gender    Gender?
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  // Role-specific one-to-one relations
  partner  Partner?
  career   Career?
  admin    Admin?
  userData UserData?

  deletions      AccountDeletion[]
  supportTickets SupportTicket[]
}

model Partner {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  first_name String
  last_name  String
  phone      String
  portfolio  String
  artisan    String

  do_you_train     String?
  willing_to_train String?

  approved Boolean @default(false) // Partners require approval
}

model Career {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  first_name String
  last_name  String
  phone      String
}

model Admin {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  name String
}

model UserData {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  name  String
  phone String
}

model OTP {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

//to store reasons 
model AccountDeletion {
  id        String   @id @default(uuid())
  userId    String
  reasons   String[]
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model SupportTicket {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())

  messages SupportMessage[]
}

model SupportMessage {
  id       String        @id @default(uuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id])

  sender  MessageSender @default(USER)
  message String

  createdAt DateTime @default(now())
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum MessageSender {
  USER
  ADMIN
  SYSTEM
}
